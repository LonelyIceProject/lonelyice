<rml>
<head>
    <title>LonelyIce</title>
    <link type="text/rcss" href="launcher.rcss"/>
</head>
<body>
<!-- Text: "@{key}" is looked up in assets/lang/<language>/*.lang while the page loads (also inside bound text). -->
<div id="frame" data-model="li">
<div id="scene">
    <div id="head">
        <div class="head-side">
            <div class="navs" data-if="page == 'main'">
                <div id="nav-settings" class="nav" data-event-click="open_page('settings')">@{page.settings}</div>
                <div id="nav-plugins" class="nav" data-event-click="open_page('plugins')">@{page.plugins}<span class="count" data-if="pl_updates > 0">{{pl_updates}}</span></div>
                <div id="nav-service" class="nav" data-event-click="open_page('service')">@{page.service}</div>
            </div>
            <div id="page-back" class="btn small" data-if="page != 'main'" data-event-click="open_page('main')">@{ui.back}</div>
            <div class="page-title" data-if="page == 'settings'">@{page.settings}</div>
            <div class="page-title" data-if="page == 'plugins'">@{page.plugins}</div>
            <div class="page-title" data-if="page == 'service'">@{page.service}</div>
        </div>
        <div class="head-logo">
            <div id="logo" data-class-small="page != 'main'">LONELYICE</div>
            <div id="sub" data-if="page == 'main'">@{ui.subtitle}</div>
        </div>
        <div class="head-side right">
            <select id="ui-lang" class="lang" data-value="ui_lang">
                <option data-for="l : langs" data-attr-value="l.id">{{l.label}}</option>
            </select>
        </div>
    </div>

    <div id="main">
        <!-- ============ main page: kept in the DOM so the console log survives page switches ============ -->
        <div class="page-main" data-class-hidden="page != 'main'">
            <div id="left">
                <div class="plate">
                    <h3>@{ui.server}</h3>
                    <div class="state">
                        <div class="orb" data-class-ok="state == 'ready'" data-class-busy="state == 'starting' || state == 'loading' || state == 'stopping'" data-class-bad="state == 'failed'"></div>
                        <div class="state-text">
                            <div class="st-title">{{state_title}}</div>
                            <div class="st-sub">{{state_sub}}</div>
                        </div>
                    </div>
                    <div class="svc"><div class="dot" data-class-on="auth_on"></div><div class="svc-name">@{ui.svc.auth}</div><div class="port">:{{auth_port}}</div></div>
                    <div class="svc"><div class="dot" data-class-on="world_on"></div><div class="svc-name">@{ui.svc.world}</div><div class="port">:{{world_port}}</div></div>
                    <div class="svc" data-if="soap_enabled"><div class="dot" data-class-on="world_on"></div><div class="svc-name">SOAP</div><div class="port">:{{soap_port}}</div></div>
                    <div class="kv-block">
                        <div class="kv"><div class="k">@{ui.kv.uptime}</div><div class="v">{{uptime}}</div></div>
                        <div class="kv"><div class="k">@{ui.kv.players}</div><div class="v">{{players}}</div></div>
                        <div class="kv"><div class="k">@{ui.kv.bots}</div><div class="v">{{bots}}</div></div>
                        <div class="kv"><div class="k">@{ui.kv.memory}</div><div class="v">{{memory}}</div></div>
                        <div class="kv"><div class="k">@{ui.kv.diff}</div><div class="v">{{diff}}</div></div>
                    </div>
                    <div class="row">
                        <div id="btn-toggle" class="btn small" data-class-danger="running" data-event-click="toggle_server">{{toggle_label}}</div>
                        <div id="btn-restart" class="btn small" data-class-disabled="!running" data-event-click="restart_server">@{ui.restart}</div>
                    </div>
                </div>

                <div class="plate">
                    <h3>@{ui.game}</h3>
                    <div class="path" data-class-missing="!client_ok">{{client_path}}</div>
                    <div class="chips">
                        <div class="chip" data-for="l : locales" data-class-ok="l.cls == 'ok'" data-class-warn="l.cls == 'warn'" data-class-bad="l.cls == 'bad'" data-class-launch="l.launch" data-event-click="pick_locale(l.name)">{{l.name}}</div>
                    </div>
                    <div class="rlnote">{{rl_note}}</div>
                    <div class="row">
                        <div id="btn-browse" class="btn small" data-event-click="browse_client">@{ui.browse}</div>
                        <div id="btn-realmlist" class="btn small" data-class-disabled="!client_ok" data-event-click="fix_realmlist">@{ui.fix_realmlist}</div>
                    </div>
                </div>

            </div>

            <div id="panel">
                <div id="tabs">
                    <div id="tab-overview" class="tab" data-class-active="tab == 'overview'" data-event-click="open_tab('overview')">@{tab.overview}</div>
                    <div id="tab-console" class="tab" data-class-active="tab == 'console'" data-event-click="open_tab('console')">@{tab.console}</div>
                    <div id="tab-commands" class="tab" data-class-active="tab == 'commands'" data-event-click="open_tab('commands')">@{tab.commands}</div>
                    <div id="tab-accounts" class="tab" data-class-active="tab == 'accounts'" data-event-click="open_tab('accounts')">@{tab.accounts}</div>
                </div>

                <!-- overview -->
                <div class="pane" data-if="tab == 'overview'">
                    <div class="ribbon" data-if="news.size > 0">@{ui.news}</div>
                    <div class="news" data-for="n : news" data-class-warn="n.kind == 'warn'" data-class-update="n.kind == 'update'">
                        <div class="news-mark"></div>
                        <div class="grow"><div class="news-title">{{n.title}}</div><div class="news-text">{{n.text}}</div></div>
                        <div class="btn small go" data-if="n.action != ''" data-event-click="news_action(n.action)">{{n.button}}</div>
                    </div>
                    <div class="ribbon">@{ui.events} <span class="ribbon-note">@{ui.today}</span></div>
                    <div id="events" class="scroll grow">
                        <div class="event" data-for="e : events"><div class="time">{{e.time}}</div><div class="msg">{{e.text}}</div></div>
                        <div class="event empty" data-if="events.size == 0"><div class="msg">@{ui.no_events}</div></div>
                    </div>
                    <div class="actions">
                        <div id="act-backup" class="action" data-class-disabled="backup_busy" data-event-click="backup_now"><div class="a-title">@{act.backup}</div><div class="a-sub">@{act.backup.sub}</div></div>
                        <div id="act-save" class="action" data-class-disabled="state != 'ready'" data-event-click="run_command('saveall')"><div class="a-title">@{act.saveall}</div><div class="a-sub">saveall</div></div>
                        <div id="act-announce" class="action" data-class-disabled="state != 'ready'" data-event-click="announce"><div class="a-title">@{act.announce}</div><div class="a-sub">@{act.announce.sub}</div></div>
                        <div id="act-folder" class="action" data-event-click="open_server_dir"><div class="a-title">@{act.folder}</div><div class="a-sub">@{act.folder.sub}</div></div>
                    </div>
                </div>

                <!-- console: kept in the DOM so the log survives tab switches -->
                <div class="pane console" data-class-hidden="tab != 'console'">
                    <div id="log"></div>
                    <div class="cmd-row">
                        <div class="prompt">AC&gt;</div>
                        <input type="text" id="cmd" class="cmd"/>
                        <div id="btn-send" class="btn small" data-event-click="send_command">@{ui.run}</div>
                    </div>
                </div>

                <!-- commands -->
                <div class="pane" data-if="tab == 'commands'">
                    <div class="toolbar">
                        <div class="f-inline">@{cmd.character}</div>
                        <select id="cmd-target" class="field target" data-if="cmd_chars.size > 0" data-value="cmd_target">
                            <option data-for="o : cmd_chars" data-attr-value="o.id">{{o.label}}</option>
                        </select>
                        <input type="text" id="cmd-target-text" class="field target" data-if="cmd_chars.size == 0" data-value="cmd_target"/>
                        <div class="spacer"></div>
                        <div class="f-inline">@{ui.search}</div>
                        <input type="text" id="cmd-search" class="field search" data-value="cmd_query"/>
                    </div>
                    <div class="cats">
                        <div class="cat" data-attr-id="'cmd-group-' + g.id" data-for="g : cmd_groups" data-class-active="cmd_query == '' && cmd_group == g.id" data-event-click="cmd_group_pick(g.id)">{{g.name}}</div>
                    </div>
                    <div class="scroll grow">
                        <div class="ccard" data-for="c, ci : cmd_cards" data-class-danger="c.danger">
                            <div class="cc-main">
                                <div class="cc-title">{{c.title}}<span class="cc-group" data-if="c.group != ''"> · {{c.group}}</span></div>
                                <div class="cc-desc" data-if="c.desc != ''">{{c.desc}}</div>
                                <div class="cc-args" data-if="c.args.size > 0">
                                    <div class="cc-arg" data-for="a : c.args">
                                        <input type="text" class="field arg" data-if="a.type != 's'" data-value="a.value"/>
                                        <select class="field arg" data-if="a.type == 's'" data-value="a.value">
                                            <option data-for="o : a.opts" data-attr-value="o.id">{{o.label}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="cc-preview">{{c.preview}}</div>
                            </div>
                            <div class="btn small go" data-attr-id="'run-' + ci" data-class-danger="c.danger" data-class-disabled="state != 'ready'" data-event-click="cmd_run(ci)">{{c.button}}</div>
                        </div>
                        <div class="note pad" data-if="cmd_cards.size == 0">@{ui.nothing_found}</div>
                    </div>
                    <div class="statusbar"><div class="note grow">{{cmd_last}}</div></div>
                </div>

                <!-- accounts -->
                <div class="pane" data-if="tab == 'accounts'">
                    <div class="scroll grow">
                        <div class="note pad" data-if="!acc_loaded">{{acc_note}}</div>
                        <div class="trow thead" data-if="acc_loaded"><div class="c1">@{acc.login}</div><div class="c2">@{acc.level}</div><div class="c3">@{acc.chars}</div><div class="c4">@{acc.last_login}</div></div>
                        <div class="trow" data-for="a : acc_rows"><div class="c1">{{a.name}}</div><div class="c2"><span data-class-gm="a.gm">{{a.level}}</span></div><div class="c3">{{a.chars}}</div><div class="c4">{{a.last}}</div></div>
                    </div>
                    <div class="ribbon">@{acc.new}</div>
                    <div class="form-row">
                        <div class="f"><div class="f-label">@{acc.login}</div><input type="text" id="acc-login" class="field" data-value="acc_login"/></div>
                        <div class="f"><div class="f-label">@{acc.password}</div><input type="password" id="acc-pass" class="field" data-value="acc_pass"/></div>
                        <div class="f"><div class="f-label">@{acc.level}</div>
                            <select id="acc-level" class="field" data-value="acc_level">
                                <option value="0">@{acc.player}</option><option value="1">GM 1</option><option value="2">GM 2</option><option value="3">GM 3</option>
                            </select>
                        </div>
                        <div id="btn-acc-create" class="btn small" data-class-disabled="state != 'ready'" data-event-click="acc_create">@{acc.create}</div>
                        <div id="btn-acc-refresh" class="btn small" data-class-disabled="state != 'ready'" data-event-click="acc_refresh">@{ui.refresh}</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============ settings page ============ -->
        <div class="page-sub" data-if="page == 'settings'" data-class-nokeys="!set_show_keys">
            <div class="side">
                <div data-for="g : set_groups">
                    <div class="side-sect" data-if="g.section != ''">{{g.section}}</div>
                    <div class="side-item" data-attr-id="'set-group-' + g.id" data-class-active="set_group == g.id" data-event-click="set_group_pick(g.id)">{{g.name}}<span class="count" data-if="g.changed > 0">{{g.changed}}</span></div>
                </div>
            </div>
            <div id="panel" class="sub">
                <div class="pane" data-if="set_group != 'about' && set_group != 'storage'">
                    <div class="toolbar" data-if="set_group == 'rates'">
                        <div class="f-inline">@{set.preset}</div>
                        <div class="pre" data-class-active="set_preset == 1" data-event-click="set_preset_pick(1)">@{set.preset.x1}</div>
                        <div class="pre" data-class-active="set_preset == 2" data-event-click="set_preset_pick(2)">@{set.preset.x2}</div>
                        <div class="pre" data-class-active="set_preset == 5" data-event-click="set_preset_pick(5)">@{set.preset.x5}</div>
                    </div>
                    <div class="toolbar">
                        <div class="group-hint grow">{{set_hint}}</div>
                        <input type="checkbox" id="set-keys" class="check" data-checked="set_show_keys"/><div class="f-inline">@{set.show_keys}</div>
                    </div>
                    <div class="scroll grow">
                        <div class="fld" data-for="f : set_fields" data-class-changed="f.changed">
                            <div class="fld-main">
                                <div class="fld-label">{{f.label}} <span class="ap" data-class-now="f.apply == 'now'" data-class-rel="f.apply == 'rel'" data-class-rst="f.apply == 'rst'">{{f.apply_text}}</span></div>
                                <div class="fld-key">{{f.key}}</div>
                                <div class="fld-hint" data-if="f.hint != ''">{{f.hint}}</div>
                            </div>
                            <div class="fld-ctl">
                                <input type="checkbox" class="check" data-attr-id="'chk-' + f.key" data-if="f.type == 'b'" data-checked="f.on"/>
                                <input type="text" class="field" data-attr-id="'set-' + f.key" data-if="f.type == 'n' || f.type == 't'" data-value="f.value"/>
                                <select class="field" data-attr-id="'sel-' + f.key" data-if="f.type == 's'" data-value="f.value">
                                    <option data-for="o : f.opts" data-attr-value="o.id">{{o.label}}</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="statusbar">
                        <div class="note grow">{{set_status}}</div>
                        <span class="ap now">@{apply.now}</span><span class="ap rel">@{apply.reload}</span><span class="ap rst">@{apply.restart}</span>
                        <div id="btn-set-save" class="btn small" data-class-disabled="!set_can_save" data-event-click="set_save">{{set_save_label}}</div>
                    </div>
                </div>
                <div class="pane" data-if="set_group == 'storage'">
                    <div class="group-hint">@{storage.hint}</div>
                    <div class="scroll grow">
                        <div class="ribbon">@{storage.location}</div>
                        <div class="opt" data-for="l : st_locs" data-attr-id="'st-loc-' + l.id" data-class-active="st_loc == l.id" data-event-click="st_pick(l.id)">
                            <div class="radio"></div>
                            <div class="grow"><div class="o-title">{{l.title}}</div><div class="o-desc">{{l.detail}}</div></div>
                            <div class="o-size" data-if="st_current == l.id">@{storage.current}</div>
                        </div>
                        <div class="remote form-row" data-if="st_remote">
                            <div class="f"><div class="f-label">@{storage.host}</div><input type="text" id="st-host" class="field" data-value="st_host"/></div>
                            <div class="f short"><div class="f-label">@{storage.port}</div><input type="text" id="st-port" class="field" data-value="st_port"/></div>
                            <div class="f"><div class="f-label">@{storage.user}</div><input type="text" id="st-user" class="field" data-value="st_user"/></div>
                            <div class="f"><div class="f-label">@{acc.password}</div><input type="password" id="st-pass" class="field" data-value="st_pass"/></div>
                            <div class="f"><div class="f-label">@{storage.prefix}</div><input type="text" id="st-prefix" class="field" data-value="st_prefix"/></div>
                        </div>
                        <div class="ribbon">@{storage.game_data}</div>
                        <div class="opt comp">
                            <input type="checkbox" id="st-cache" class="check" data-if="!st_remote" data-checked="st_cache"/>
                            <div class="ic ok" data-if="st_remote">+</div>
                            <div class="grow"><div class="o-title">@{storage.cache}</div><div class="o-desc">{{st_cache_desc}}</div></div>
                        </div>
                        <div class="stcheck" data-if="st_note != ''" data-class-ok="st_state == 'ok'" data-class-warn="st_state == 'warn'" data-class-bad="st_state == 'bad'" data-class-run="st_state == 'run'">
                            <div class="grow">{{st_note}}</div>
                            <div id="st-check" class="btn small" data-if="st_state != 'run'" data-event-click="st_check">@{storage.check}</div>
                        </div>
                    </div>
                    <div class="statusbar">
                        <div class="note grow">{{st_status}}</div>
                        <div id="btn-st-revert" class="btn small" data-class-disabled="!st_changed || st_busy" data-event-click="st_revert">@{storage.revert}</div>
                        <div id="btn-st-apply" class="btn small" data-class-disabled="!st_changed || st_busy" data-event-click="st_apply">@{storage.apply}</div>
                    </div>
                </div>
                <div class="pane" data-if="set_group == 'about'">
                    <div class="about-logo">LONELYICE</div>
                    <div class="group-hint">@{about.hint}</div>
                    <div class="scroll grow">
                        <div class="drow" data-for="r : about_rows">
                            <div class="d-main"><div class="d-title">{{r.title}}</div><div class="d-detail sel">{{r.detail}}</div></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============ plugins page ============ -->
        <div class="page-sub" data-if="page == 'plugins'">
            <div class="side">
                <div class="side-sect">@{pl.show}</div>
                <div id="pl-view-installed" class="side-item" data-class-active="pl_view == 'installed'" data-event-click="pl_view_pick('installed')">@{pl.view.installed}</div>
                <div id="pl-view-updates" class="side-item" data-class-active="pl_view == 'updates'" data-event-click="pl_view_pick('updates')">@{pl.view.updates}<span class="count" data-if="pl_updates > 0">{{pl_updates}}</span></div>
                <div id="pl-view-catalog" class="side-item" data-class-active="pl_view == 'catalog'" data-event-click="pl_view_pick('catalog')">@{pl.view.catalog}</div>
                <div class="side-sect" data-if="pl_view == 'catalog'">@{pl.locale}</div>
                <select id="pl-locale" class="lang side-select" data-if="pl_view == 'catalog'" data-value="pl_locale">
                    <option data-for="o : pl_locales" data-attr-value="o.id">{{o.label}}</option>
                </select>
                <div class="side-sect">@{pl.repos}</div>
                <div class="side-repo" data-for="r : pl_repos" data-class-off="!r.enabled">
                    <div class="dot" data-class-on="r.ok" data-class-warn="!r.enabled || (!r.ok && !r.failed)"></div>
                    <div class="grow"><div>{{r.title}}</div><div class="side-note">{{r.kind}} · {{r.note}}</div></div>
                </div>
                <div class="spacer"></div>
                <div id="pl-view-repos" class="btn small wide" data-event-click="pl_view_pick('repos')">@{pl.manage_repos}</div>
            </div>
            <div id="panel" class="sub">
                <div class="pane" data-if="pl_view != 'repos'">
                    <div class="scroll grow">
                        <div class="ccard" data-for="p, pi : pl_rows" data-class-off="p.installed && !p.enabled">
                            <img class="pl-icon" data-if="p.icon != ''" data-attr-src="p.icon"/>
                            <div class="pl-icon pl-letter" data-if="p.icon == ''"><span>{{p.letter}}</span></div>
                            <div class="cc-main">
                                <div class="cc-title">{{p.name}}<span class="cc-group"> · {{p.version}}</span><span class="upd" data-if="p.update != ''">{{p.update}}</span></div>
                                <div class="cc-desc" data-if="p.desc != ''">{{p.desc}}</div>
                                <div class="cc-preview">{{p.note}}</div>
                            </div>
                            <div class="btn small go" data-attr-id="'pl-page-' + p.id" data-if="p.page != ''" data-attr-title="p.page" data-event-click="pl_page(pi)">@{pl.page}</div>
                            <div class="btn small go gear" data-attr-id="'pl-settings-' + p.id" data-if="p.settings != ''" data-attr-title="'@{pl.settings}'" data-event-click="open_page('settings', p.settings)"></div>
                            <div class="btn small go" data-attr-id="'pl-install-' + p.id" data-if="!p.installed || p.update != ''" data-class-disabled="pl_busy" data-event-click="pl_install(pi)">{{p.installed ? '@{pl.update}' : '@{pl.install}'}}</div>
                            <div class="btn small go" data-attr-id="'pl-toggle-' + p.id" data-if="p.installed" data-class-disabled="pl_busy" data-event-click="pl_toggle(pi)">{{p.enabled ? '@{ui.disable}' : '@{ui.enable}'}}</div>
                            <div class="btn small go danger" data-attr-id="'pl-remove-' + p.id" data-if="p.installed" data-class-disabled="pl_busy" data-event-click="pl_remove(pi)">@{ui.remove}</div>
                        </div>
                        <div class="note pad" data-if="pl_rows.size == 0 && pl_view == 'installed'">@{pl.empty.installed}</div>
                        <div class="note pad" data-if="pl_rows.size == 0 && pl_view == 'updates'">@{pl.empty.updates}</div>
                        <div class="note pad" data-if="pl_rows.size == 0 && pl_view == 'catalog' && pl_locale == ''">@{pl.empty.catalog}</div>
                        <div class="note pad" data-if="pl_rows.size == 0 && pl_view == 'catalog' && pl_locale != ''">@{pl.empty.catalog_locale}</div>
                    </div>
                    <div class="statusbar">
                        <div class="note grow">{{pl_status}}</div>
                        <div id="btn-pl-check" class="btn small" data-class-disabled="pl_busy" data-event-click="pl_check">@{pl.check}</div>
                        <div id="btn-pl-update" class="btn small" data-class-disabled="pl_busy" data-event-click="pl_update_all">@{pl.update_all}</div>
                    </div>
                </div>
                <div class="pane" data-if="pl_view == 'repos'">
                    <div class="ribbon">@{pl.repos}</div>
                    <div class="scroll grow">
                        <div class="drow" data-for="r, ri : pl_repos">
                            <div class="dot big" data-class-on="r.ok" data-class-warn="!r.enabled || (!r.ok && !r.failed)"></div>
                            <div class="d-main">
                                <div class="d-title">{{r.title}}<span class="cc-group"> · {{r.kind}}</span></div>
                                <div class="cc-preview">{{r.location}}</div>
                                <div class="d-detail">{{r.note}}</div>
                            </div>
                            <div class="btn small go" data-attr-id="'repo-toggle-' + ri" data-class-disabled="pl_busy" data-event-click="pl_repo_toggle(ri)">{{r.enabled ? '@{ui.disable}' : '@{ui.enable}'}}</div>
                            <div class="btn small go danger" data-attr-id="'repo-remove-' + ri" data-class-disabled="pl_busy" data-event-click="pl_repo_remove(ri)">@{ui.remove}</div>
                        </div>
                        <div class="note pad" data-if="pl_repos.size == 0">@{pl.repos.empty}</div>
                        <div class="ribbon">@{pl.repos.add}</div>
                        <div class="repo-add">
                            <input type="text" id="repo-new" class="field" data-value="pl_repo_new"/>
                            <div id="btn-repo-add" class="btn small" data-class-disabled="pl_busy" data-event-click="pl_repo_add">@{ui.add}</div>
                            <div id="btn-repo-browse" class="btn small" data-class-disabled="pl_busy" data-event-click="pl_repo_browse">@{ui.folder}</div>
                        </div>
                        <div class="note pad">@{pl.repos.help}</div>
                        <div class="row" data-if="!pl_has_official"><div id="btn-repo-official" class="btn small" data-class-disabled="pl_busy" data-event-click="pl_repo_official">@{pl.repos.official}</div></div>
                    </div>
                    <div class="statusbar">
                        <div class="note grow">{{pl_status}}</div>
                        <div id="btn-repos-back" class="btn small" data-event-click="pl_view_pick('installed')">@{pl.back_to_list}</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============ service page ============ -->
        <div class="page-sub" data-if="page == 'service'">
            <div class="side">
                <div id="svc-data" class="side-item" data-class-active="svc_section == 'data'" data-event-click="svc_pick('data')">@{svc.data}</div>
                <div id="svc-backups" class="side-item" data-class-active="svc_section == 'backups'" data-event-click="svc_pick('backups')">@{svc.backups}</div>
                <div id="svc-logs" class="side-item" data-class-active="svc_section == 'logs'" data-event-click="svc_pick('logs')">@{svc.logs}</div>
            </div>
            <div id="panel" class="sub">
                <div class="pane" data-if="svc_section == 'data'">
                    <div class="ribbon">@{svc.data} <span class="ribbon-note">{{data_sum}}</span></div>
                    <div class="drow storage">
                        <div class="d-main"><div class="d-title">{{storage_title}}</div><div class="d-detail">{{storage_detail}}</div></div>
                        <div id="btn-storage" class="btn small" data-event-click="open_page('settings', 'storage')">@{data.storage.change}</div>
                    </div>
                    <div class="scroll grow">
                        <div class="drow" data-for="d : data_rows">
                            <div class="dot big" data-class-on="d.status == 'ok'" data-class-warn="d.status == 'warn'"></div>
                            <div class="d-main"><div class="d-title">{{d.title}}</div><div class="d-detail">{{d.detail}}</div></div>
                            <div class="d-size">{{d.size}}</div>
                        </div>
                    </div>
                    <div class="statusbar">
                        <div class="note grow">@{svc.data.note}</div>
                        <div id="btn-data-wizard" class="btn small" data-event-click="open_wizard">@{svc.wizard}</div>
                        <div id="btn-data-check" class="btn small" data-event-click="data_check">@{svc.check}</div>
                        <div id="btn-data-open" class="btn small" data-event-click="open_data">@{ui.open_folder}</div>
                    </div>
                </div>
                <div class="pane" data-if="svc_section == 'backups'">
                    <div class="ribbon">@{svc.backups} <span class="ribbon-note">{{backup_sum}}</span></div>
                    <div class="scroll grow">
                        <div class="drow" data-for="d : backup_rows">
                            <div class="d-main"><div class="d-title">{{d.title}}</div><div class="d-detail">{{d.detail}}</div></div>
                            <div class="d-size">{{d.size}}</div>
                        </div>
                        <div class="note pad" data-if="backup_rows.size == 0">@{svc.backups.empty}</div>
                    </div>
                    <div class="statusbar">
                        <div class="note grow">@{svc.backups.note}</div>
                        <div id="btn-backup-now" class="btn small" data-class-disabled="backup_busy" data-event-click="backup_now">@{svc.backup_now}</div>
                        <div id="btn-backup-open" class="btn small" data-event-click="open_backups">@{ui.open_folder}</div>
                    </div>
                </div>
                <div class="pane" data-if="svc_section == 'logs'">
                    <div class="ribbon">@{svc.logs} <span class="ribbon-note">{{logs_dir}}</span></div>
                    <div class="scroll grow">
                        <div class="drow" data-for="d : log_rows">
                            <div class="d-main"><div class="d-title">{{d.title}}</div></div>
                            <div class="d-size">{{d.size}}</div>
                        </div>
                        <div class="note pad" data-if="log_rows.size == 0">@{svc.logs.empty}</div>
                    </div>
                    <div class="statusbar">
                        <div class="note grow">@{svc.logs.note}</div>
                        <div id="btn-logs-open" class="btn small" data-event-click="open_logs">@{ui.open_folder}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="foot">
        <div class="foot-info">
            <div id="message" data-if="message != ''">{{message}}</div>
            <div class="foot-status">{{foot_status}}</div>
            <div class="foot-bar"><div class="foot-fill" data-class-busy="foot_busy"></div></div>
        </div>
        <div id="play" data-class-disabled="!play_enabled" data-event-click="play">
            <div class="play-title">{{play_label}}</div>
            <div class="play-sub">{{play_sub}}</div>
        </div>
    </div>
    <div id="credit">@{ui.credit}</div>

    <div id="wiz" data-if="wz_open">
        <div class="wbox">
            <div class="whead"><div class="wtitle">@{wz.title}</div><div class="wcount">{{wz_counter}}</div></div>
            <div class="wsteps"><div class="wst" data-for="s : wz_steps" data-class-done="s.cls == 'done'" data-class-cur="s.cls == 'cur'">{{s.name}}</div></div>
            <div class="wbody scroll">
                <!-- 0 client -->
                <div data-if="wz_step == 0">
                    <div class="wh">@{wz.client}</div>
                    <div class="detect">
                        <div class="orb" data-class-ok="wz_client_found" data-class-bad="!wz_client_found"></div>
                        <div class="grow"><div class="d-title">{{wz_client_title}}</div><div class="path">{{wz_client_path}}</div></div>
                    </div>
                    <div class="check" data-for="c : wz_checks">
                        <div class="ic" data-class-ok="c.cls == 'ok'" data-class-warn="c.cls == 'warn'" data-class-bad="c.cls == 'bad'">{{c.cls == 'ok' ? '+' : '!'}}</div>
                        <div class="grow">{{c.text}}</div><div class="cdetail">{{c.detail}}</div>
                    </div>
                    <div class="note">@{wz.client.order}</div>
                    <div class="row"><div id="wz-browse-client" class="btn small" data-event-click="wz_browse_client">@{wz.client.browse}</div></div>
                </div>
                <!-- 1 place -->
                <div data-if="wz_step == 1">
                    <div class="wh">@{wz.place}</div>
                    <div class="opt" data-for="p : wz_places" data-attr-id="'wz-place-' + p.id" data-class-active="wz_place == p.id" data-event-click="wz_pick_place(p.id)">
                        <div class="radio"></div>
                        <div class="grow"><div class="o-title">{{p.title}}</div><div class="path small">{{p.path}}</div><div class="o-desc">{{p.detail}}</div></div>
                        <div class="o-size">{{p.free}}</div>
                    </div>
                    <div class="row"><div id="wz-browse-place" class="btn small" data-event-click="wz_browse_place">@{wz.place.browse}</div></div>
                    <div class="note">@{wz.place.note}</div>
                </div>
                <!-- 2 data: where it is kept, then what gets installed -->
                <div data-if="wz_step == 2">
                    <div class="wh">@{wz.storage}</div>
                    <div class="opt" data-for="l : wzs_locs" data-attr-id="'wz-loc-' + l.id" data-class-active="wzs_loc == l.id" data-event-click="wzs_pick(l.id)">
                        <div class="radio"></div>
                        <div class="grow"><div class="o-title">{{l.title}}</div><div class="o-desc">{{l.detail}}</div></div>
                    </div>
                    <div class="remote form-row" data-if="wzs_remote">
                        <div class="f"><div class="f-label">@{storage.host}</div><input type="text" id="wzs-host" class="field" data-value="wzs_host"/></div>
                        <div class="f short"><div class="f-label">@{storage.port}</div><input type="text" id="wzs-port" class="field" data-value="wzs_port"/></div>
                        <div class="f"><div class="f-label">@{storage.user}</div><input type="text" id="wzs-user" class="field" data-value="wzs_user"/></div>
                        <div class="f"><div class="f-label">@{acc.password}</div><input type="password" id="wzs-pass" class="field" data-value="wzs_pass"/></div>
                        <div class="f"><div class="f-label">@{storage.prefix}</div><input type="text" id="wzs-prefix" class="field" data-value="wzs_prefix"/></div>
                    </div>
                    <div class="opt comp">
                        <input type="checkbox" id="wzs-cache" class="check" data-if="!wzs_remote" data-checked="wzs_cache"/>
                        <div class="ic ok" data-if="wzs_remote">+</div>
                        <div class="grow"><div class="o-title">@{storage.cache}</div><div class="o-desc">{{wzs_cache_desc}}</div></div>
                    </div>
                    <div class="stcheck" data-if="wzs_note != ''" data-class-ok="wzs_state == 'ok'" data-class-warn="wzs_state == 'warn'" data-class-bad="wzs_state == 'bad'" data-class-run="wzs_state == 'run'">
                        <div class="grow">{{wzs_note}}</div>
                        <div id="wzs-check" class="btn small" data-if="wzs_state != 'run'" data-event-click="wzs_check">@{storage.check}</div>
                    </div>
                    <div class="wh2">@{wz.comps.required}</div>
                    <div data-for="c : wz_comps">
                        <div class="opt comp" data-if="c.required" data-attr-id="'wz-comp-' + c.id" data-class-locked="c.locked" data-class-have="!c.on">
                            <div class="ic" data-class-ok="c.on">{{c.on ? '+' : '•'}}</div>
                            <div class="grow"><div class="o-title">{{c.title}}</div><div class="o-desc">{{c.desc}}</div><div class="o-note" data-if="c.note != ''">{{c.note}}</div></div>
                            <div class="o-size" data-if="c.on">{{c.size}}</div>
                        </div>
                    </div>
                    <div class="wh2">@{wz.comps.optional}</div>
                    <div data-for="c : wz_comps">
                        <div class="opt comp" data-if="!c.required">
                            <input type="checkbox" class="check" data-attr-id="'wz-comp-' + c.id" data-checked="c.on"/>
                            <div class="grow"><div class="o-title">{{c.title}}</div><div class="o-desc">{{c.desc}}</div><div class="o-note" data-if="c.note != ''">{{c.note}}</div></div>
                            <div class="o-size">{{c.size}}</div>
                        </div>
                    </div>
                    <div class="form-row wz-threads">
                        <div class="f-inline">@{wz.threads}</div>
                        <input type="text" id="wz-threads" class="field short" data-value="wz_threads"/>
                        <div class="f-inline">{{wz_cores_note}}</div>
                    </div>
                    <div class="note">{{wz_total}}</div>
                </div>
                <!-- 3 world and account -->
                <div data-if="wz_step == 3">
                    <div class="wh">@{wz.world}</div>
                    <div class="form-row">
                        <div class="f"><div class="f-label">@{wz.realm_name}</div><input type="text" id="wz-realm" class="field" data-value="wz_realm"/></div>
                        <div class="f"><div class="f-label">@{wz.rates}</div>
                            <select id="wz-rate" class="field" data-value="wz_rate"><option value="1">@{set.preset.x1}</option><option value="2">@{set.preset.x2}</option><option value="5">@{set.preset.x5}</option></select></div>
                        <div class="f"><div class="f-label">@{wz.bots}</div>
                            <select id="wz-bots" class="field" data-value="wz_bots"><option value="0">@{wz.bots.0}</option><option value="100">@{wz.bots.100}</option><option value="500">@{wz.bots.500}</option><option value="1000">@{wz.bots.1000}</option></select></div>
                    </div>
                    <div class="form-row">
                        <div class="f"><div class="f-label">@{acc.login}</div><input type="text" id="wz-login" class="field" data-value="wz_login"/></div>
                        <div class="f"><div class="f-label">@{acc.password}</div><input type="password" id="wz-pass" class="field" data-value="wz_pass"/></div>
                        <div class="f"><div class="f-label">@{wz.rights}</div>
                            <select id="wz-gm" class="field" data-value="wz_gm"><option value="0">@{acc.player}</option><option value="3">@{wz.rights.admin}</option></select></div>
                    </div>
                    <div class="note">@{wz.world.note}</div>
                </div>
                <!-- 4 client preparation -->
                <div data-if="wz_step == 4">
                    <div class="wh">@{wz.prep}</div>
                    <div class="opt comp"><input type="checkbox" id="wz-rl" class="check" data-checked="wz_rl"/>
                        <div class="grow"><div class="o-title">@{wz.prep.rl}</div><div class="o-desc">@{wz.prep.rl.desc}</div></div><div class="o-size">{{wz_rl_note}}</div></div>
                    <div class="opt comp"><input type="checkbox" id="wz-wdb" class="check" data-checked="wz_wdb"/>
                        <div class="grow"><div class="o-title">@{wz.prep.wdb}</div><div class="o-desc">@{wz.prep.wdb.desc}</div></div><div class="o-size">Cache\WDB</div></div>
                    <div class="opt comp"><input type="checkbox" id="wz-accname" class="check" data-checked="wz_accname"/>
                        <div class="grow"><div class="o-title">@{wz.prep.accname}</div><div class="o-desc">SET accountName "{{wz_login}}"</div></div><div class="o-size">WTF\Config.wtf</div></div>
                    <div class="opt comp" data-if="wz_lnk_supported"><input type="checkbox" id="wz-lnk" class="check" data-checked="wz_lnk"/>
                        <div class="grow"><div class="o-title">@{wz.prep.lnk}</div><div class="o-desc">@{wz.prep.lnk.desc}</div></div></div>
                </div>
                <!-- 5 install -->
                <div data-if="wz_step == 5">
                    <div class="wh">@{wz.install}</div>
                    <div class="istep" data-for="r, ri : wz_inst" data-class-done="r.state == 'done'" data-class-run="r.state == 'run'" data-class-fail="r.state == 'fail'">
                        <div class="inum">{{r.state == 'done' ? '+' : r.state == 'fail' ? '!' : ri + 1}}</div>
                        <div class="grow">
                            <div class="irow"><div class="o-title grow">{{r.title}}</div><div class="inote">{{r.note}}</div></div>
                            <div class="bar"><div class="fill" data-style-width="r.pct + '%'"></div></div>
                        </div>
                    </div>
                    <div class="wlog"><div data-for="l : wz_log">{{l}}</div></div>
                    <div class="note">@{wz.install.note}</div>
                </div>
                <!-- 6 done -->
                <div data-if="wz_step == 6">
                    <div class="wh">@{wz.done}</div>
                    <div class="check" data-for="c : wz_done">
                        <div class="ic ok">+</div><div class="grow">{{c.text}}</div><div class="cdetail">{{c.detail}}</div>
                    </div>
                    <div class="pad" data-if="!wz_switching">@{wz.done.note}</div>
                </div>
                <!-- 7 moving to another storage -->
                <div data-if="wz_step == 7">
                    <div class="wh">@{wz.transfer}</div>
                    <div class="pad">{{wz_transfer_title}}</div>
                    <div class="check" data-for="c : wz_transfer">
                        <div class="ic ok">+</div><div class="grow">{{c.text}}</div><div class="cdetail">{{c.detail}}</div>
                    </div>
                    <div data-if="wz_need_account">
                        <div class="wh2">@{wz.transfer.account}</div>
                        <div class="form-row">
                            <div class="f"><div class="f-label">@{acc.login}</div><input type="text" id="wzt-login" class="field" data-value="wz_login"/></div>
                            <div class="f"><div class="f-label">@{acc.password}</div><input type="password" id="wzt-pass" class="field" data-value="wz_pass"/></div>
                            <div class="f"><div class="f-label">@{wz.rights}</div>
                                <select id="wzt-gm" class="field" data-value="wz_gm"><option value="0">@{acc.player}</option><option value="3">@{wz.rights.admin}</option></select></div>
                        </div>
                    </div>
                    <div class="note" data-if="wz_transfer_note != ''">{{wz_transfer_note}}</div>
                </div>
            </div>
            <div class="werr" data-if="wz_error != ''">{{wz_error}}</div>
            <div class="wfoot">
                <div id="wz-cancel" class="btn small" data-if="!(wz_switching && wz_step == 6)" data-event-click="wz_cancel">{{wz_cancel_label}}</div>
                <div class="spacer"></div>
                <div id="wz-back" class="btn small" data-if="wz_back_visible" data-event-click="wz_back">@{ui.back_step}</div>
                <div id="wz-next" class="btn next" data-class-disabled="!wz_next_ok" data-event-click="wz_next">{{wz_next_label}}</div>
            </div>
        </div>
    </div>

    <div id="overlay" data-if="closing">
        <div class="overlay-box">
            <div class="ov-title">@{ui.closing}</div>
            <div class="ov-text">@{ui.closing.text}</div>
        </div>
    </div>
</div>
</div>
</body>
</rml>
