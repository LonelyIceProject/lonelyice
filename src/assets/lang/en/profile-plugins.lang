# YAML plugin profile and exact-version reconciliation.
profile.plugins.mapping = The profile plugins section must map plugin IDs to mappings with version and enabled fields.
profile.plugins.version = Plugin '{0}' requires a nonempty exact version string in YAML.
profile.plugins.enabled = Plugin '{0}' enabled must be a YAML boolean.
profile.plugins.unavailable = Exact package '{0}' version '{1}' is not available for {2} in the loaded compatible catalog. Load the correct catalog; no other version will be substituted.
profile.plugins.dependency = Enabled plugin '{0}' requires '{1}' ({2}); list that dependency in the profile with enabled: true and an exact version.
profile.plugins.range = Plugin '{0}' requires '{1}' ({2}), but the profile selects version {3}.
profile.plugins.conflict = Profile plugins '{0}' and '{1}' conflict; they cannot both be enabled.
profile.plugins.active_storage = The profile would disable active storage provider '{0}'. Select another storage location before applying this plugin profile.
profile.plugins.cycle = Enabled plugin dependency cycle at '{0}'.
profile.plugins.review = Apply the profile's exact versions and enabled states. Unlisted plugins will be disabled, with files retained. Stop the server and review the changes below.
profile.plugins.install = Install/update {0}: {1} -> {2}
profile.plugins.missing = missing
profile.plugins.disable = Disable {0}
profile.plugins.enable = Enable {0}
profile.plugins.retain = Retain unlisted folder {0} (disabled)
profile.plugins.matches = Installed plugins already match the profile.
profile.plugins.cancelled = Plugin reconciliation was cancelled. Rescan actual disk state and review a fresh plan before retrying; earlier completed changes may remain.
profile.plugins.stop_required = Stop the server outside this TUI before applying the plugin profile.
profile.plugins.stale = The profile or installed plugins changed since the preview. Review a new plan before applying.
profile.plugins.verify = Installed plugin '{0}' did not reach the reviewed exact version/enabled state. Rescan and review again.
profile.plugins.mismatch = Plugin '{0}' must be installed at exact version {1}, {2}, and compatible with this build. Run --pkg sync --settings <server.yaml> to reconcile the profile.
profile.plugins.extra = Unlisted plugin '{0}' is enabled. Run --pkg sync --settings <server.yaml> to review disabling it while retaining its folder.
profile.plugins.on = enabled
profile.plugins.off = disabled
profile.plugins.preview = Review YAML plugins
profile.plugins.applied = Plugin folders now match the YAML profile. Generated configuration will use the profile's plugin settings.
profile.plugins.failed = Plugin reconciliation failed: {0}. The desired YAML list was retained; some completed folder changes may remain. Review a fresh plan before retrying.
profile.plugins.saved = Package change succeeded and its affected plugin entries were saved in YAML.
profile.plugins.save_failed = Package folders changed, but their affected YAML entries could not be saved: {0}. Review the actual folders and profile before continuing.
